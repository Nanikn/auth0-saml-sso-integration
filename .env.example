# Copy this file to .env in the repo root and fill in the three Auth0 values.
# There is no client secret on purpose. This app speaks SAML, not the OIDC code flow.
# See README.md for the dashboard clicks, and DECISIONS.md for why these are the only secrets.

# Host only. Example: dev-abc123.us.auth0.com
AUTH0_DOMAIN=your-tenant.us.auth0.com

# Regular Web Application → Settings → Client ID
AUTH0_CLIENT_ID=your-client-id

# Browser origin of the demo UI. The Vite dev server proxies /api to the backend.
# The Auth0 callback URLs in auth0/saml-addon-settings.json must use this same origin.
APP_BASE_URL=http://localhost:5173

# openssl rand -hex 32
# Rejected at startup if it is shorter than 32 characters or still the placeholder.
SESSION_SECRET=replace-with-a-long-random-string

# Must match "audience" in the Auth0 SAML addon settings.
SP_ENTITY_ID=urn:platform:sp

# Optional. Defaults to 4000. The browser should still open APP_BASE_URL, not this port.
PORT=4000

# Optional override. Leave unset and the server will read the signing cert from
# https://{AUTH0_DOMAIN}/samlp/metadata/{AUTH0_CLIENT_ID} at startup.
# If you set it, use one line of base64 (the body of the PEM, headers stripped).
# SAML_IDP_CERT=
